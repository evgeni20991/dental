---
import type { Content } from '../content/site';
interface Props { c: Content; }
const { c } = Astro.props;
---
<section id="why" class="section why">
  <div class="shell">
    <div class="sec-head">
      <p class="label" data-reveal>{c.why.label}</p>
      <h2 class="h2" data-reveal>{c.why.title}</h2>
    </div>
    <div class="why-grid">
      {c.why.items.map((w) => (
        <div class="why-item" data-reveal>
          <span class="numeral why-n">{w.n}</span>
          <div>
            <h3 class="h3">{w.title}</h3>
            <p class="why-text">{w.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why { background: var(--color-surface); border-block: 1px solid var(--color-line); }
  .why-grid { display: grid; gap: clamp(30px, 4vw, 52px); }
  .why-item { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start; }
  .why-n { color: var(--color-accent); opacity: 0.9; min-width: 2.2ch; }
  .why-text { margin-top: 8px; color: var(--color-muted); font-size: 0.97rem; max-width: 46ch; }
  @media (min-width: 860px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
