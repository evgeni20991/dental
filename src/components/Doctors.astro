---
import type { Content } from '../content/site';
interface Props { c: Content; }
const { c } = Astro.props;
---
<section id="doctors" class="section doctors">
  <div class="shell">
    <div class="sec-head">
      <p class="label" data-reveal>{c.doctors.label}</p>
      <h2 class="h2" data-reveal>{c.doctors.title}</h2>
      <p class="lead sec-lead" data-reveal>{c.doctors.lead}</p>
    </div>
    <div class="doc-grid">
      {c.doctors.items.map((d) => (
        <figure class="doc card press" data-reveal-soft>
          <div class="doc-photo">
            <img src={d.photo} alt={`${d.name} — ${d.role}`} width="560" height="616" loading="lazy" decoding="async" />
          </div>
          <figcaption>
            <p class="doc-name">{d.name}</p>
            <p class="doc-role">{d.role}</p>
            <p class="doc-exp">{d.exp}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .doctors { background: var(--color-surface); border-block: 1px solid var(--color-line); }
  .doc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .doc {
    padding: 0; overflow: hidden; background: var(--color-canvas);
    transition: transform 420ms var(--ease-out-soft), border-color 420ms var(--ease-out-soft);
  }
  @media (hover: hover) { .doc:hover { transform: translateY(-5px); border-color: var(--color-line); } }
  .doc-photo { overflow: hidden; background: var(--color-wash); }
  .doc-photo img {
    width: 100%; height: auto; display: block;
    transition: transform 700ms var(--ease-out-soft);
  }
  @media (hover: hover) { .doc:hover .doc-photo img { transform: scale(1.035); } }
  .doc figcaption { padding: 16px 18px 20px; }
  .doc-name { font-size: 1rem; font-weight: 500; }
  .doc-role { font-size: 0.85rem; color: var(--color-muted); margin-top: 3px; }
  .doc-exp { font-size: 0.8rem; color: var(--color-faint); margin-top: 2px; }
  @media (min-width: 900px) { .doc-grid { grid-template-columns: repeat(4, 1fr); } }
</style>
