---
// Липкая нижняя панель — только для телефона.
// Причина: единственная точка конверсии (форма) лежит почти в 8000 px от верха.
// Человек, который читает сайт в метро, не должен искать, куда нажать.
import type { Content } from '../content/site';
import { brand } from '../content/site';
interface Props { c: Content; }
const { c } = Astro.props;
---
<div class="mbar" data-mbar>
  <a href={brand.phoneHref} class="mbar-call press">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M4.6 3h3l1.2 3-1.7 1.2a9.5 9.5 0 0 0 4.7 4.7L13 10.2l3 1.2v3a1.5 1.5 0 0 1-1.7 1.5A12.6 12.6 0 0 1 3.1 4.7 1.5 1.5 0 0 1 4.6 3Z"
            stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
    {c.callLabel}
  </a>
  <a href="#booking" class="mbar-book press">{c.navCta}</a>
</div>

<style>
  .mbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
    display: grid; grid-template-columns: 1fr 1.2fr; gap: 10px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--color-line);
    transform: translateY(110%);
    will-change: transform;
  }
  .mbar.is-in { transform: translateY(0); }
  .mbar a {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 50px;                      /* палец, а не курсор */
    border-radius: var(--radius-pill);
    font-size: 0.95rem; font-weight: 500; text-decoration: none;
    transition: transform var(--dur-micro) var(--ease-out-soft);
  }
  .mbar a:active { transform: scale(0.97); }
  .mbar-call { border: 1px solid var(--color-line); color: var(--color-ink); }
  .mbar-book { background: var(--color-accent); color: var(--color-on-accent); }

  @media (min-width: 900px) { .mbar { display: none; } }
  @media (prefers-reduced-motion: reduce) { .mbar { transition: none; } }
</style>

<script>
  /* Панель появляется, когда герой уехал вверх: над первым экраном она лишняя,
     там кнопка и так на виду. И прячется над формой, чтобы не дублировать её. */
  const bar = document.querySelector('[data-mbar]') as HTMLElement | null;
  const booking = document.querySelector('#booking');
  if (bar) {
    bar.style.transition = 'transform 420ms cubic-bezier(0.22, 1, 0.36, 1)';
    let pastHero = false;
    let atForm = false;
    const apply = () => bar.classList.toggle('is-in', pastHero && !atForm);

    const heroSentinel = document.querySelector('.hero');
    if (heroSentinel) {
      new IntersectionObserver(
        ([e]) => { pastHero = !e.isIntersecting; apply(); },
        { rootMargin: '-120px 0px 0px 0px' },
      ).observe(heroSentinel);
    }
    if (booking) {
      new IntersectionObserver(
        ([e]) => { atForm = e.isIntersecting; apply(); },
        { threshold: 0.15 },
      ).observe(booking);
    }
  }
</script>
