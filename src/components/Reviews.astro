---
import type { Content } from '../content/site';
import { brand } from '../content/site';
interface Props { c: Content; }
const { c } = Astro.props;
---
<section id="reviews" class="section reviews">
  <div class="shell rev-wrap">
    <div>
      <p class="label" data-reveal>{c.reviews.label}</p>
      <h2 class="h2 rev-title" data-reveal>{c.reviews.title}</h2>
    </div>
    <div>
      <p class="lead" data-reveal>{c.reviews.lead}</p>
      <a href={brand.mapUrl} target="_blank" rel="noopener" class="btn btn-ghost press rev-cta" data-reveal>
        {c.reviews.cta}
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews { border-top: 1px solid var(--color-line); }
  .rev-wrap { display: grid; gap: 24px; }
  .rev-title { margin-top: 14px; }
  .rev-cta { margin-top: 22px; }
  @media (min-width: 900px) {
    .rev-wrap { grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: start; }
  }
</style>
